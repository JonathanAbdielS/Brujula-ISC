# Copia este archivo a .env y ajusta
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:7b -> ~5 GB de RAM, buen uso de herramientas (recomendado con 32 GB / 8 vCPU)
# qwen2.5:3b -> ~2 GB, el doble de rápido en CPU, algo menos preciso
OLLAMA_MODEL=qwen2.5:7b
NUM_CTX=8192
TEMPERATURE=0.3
OLLAMA_TIMEOUT=180
# -1 = el modelo se queda cargado en RAM (respuestas rápidas desde la primera pregunta)
OLLAMA_KEEP_ALIVE=-1
MAX_HISTORY=12
RATE_LIMIT_PER_MIN=12
